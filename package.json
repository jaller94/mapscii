{
  "name": "mapscii",
  "version": "0.3.1",
  "description": "MapSCII is a Braille & ASCII world map renderer for your console, based on OpenStreetMap",
  "type": "module",
  "scripts": {
    "fmt": "deno fmt src",
    "lint": "deno lint src",
    "start": "deno --allow-all main.ts",
    "test": "deno test src"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rastapasta/mapscii.git"
  },
  "bin": {
    "mapscii": "./bin/mapscii.sh"
  },
  "keywords": [
    "map",
    "console",
    "terminal",
    "ascii",
    "osm",
    "vectortile"
  ],
  "author": "Michael Straßburger <codepoet@cpan.org>",
  "license": "MIT",
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.4",
    "@types/rbush": "^4.0.0",
    "@types/yargs": "^17.0.35",
    "bresenham": "0.0.4",
    "earcut": "^3.0.2",
    "env-paths": "^4.0.0",
    "keypress": "^0.2.1",
    "node-fetch": "^3.3.2",
    "pbf": "^4.0.1",
    "rbush": "^4.0.1",
    "simplify-js": "^1.2.4",
    "string-width": "^8.2.0",
    "term-mouse": "^0.2.2",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/deno": "^2.5.0",
    "@types/node": "^25.6.0"
  }
}
